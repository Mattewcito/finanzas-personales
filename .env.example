# Credenciales de Turso (base de datos remota gratuita).
# Copia este archivo como ".env" (sin el .example) y rellena los valores.
# El .env nunca se sube a git (ya está en .gitignore).
#
# Cómo obtenerlos:
#   1. Crea una cuenta gratis en https://turso.tech  (no pide tarjeta)
#   2. En el panel → Create Database → elige un nombre y la región más cercana
#   3. En la BD creada → "Generate Token" → copia el token
#   4. La URL tiene la forma:  libsql://<nombre-bd>-<tu-org>.turso.io
#
# Sin estas vars, la app usa ./data/finanzas.db como fallback local (dev/tests).

TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui
