# ============================================================
# NUNCA subir datos financieros reales ni credenciales a GitHub.
# Todo lo que sea información personal real vive solo en local.
# ============================================================

# Datos reales (Excel, base de datos, extractos, facturas escaneadas)
data/*
!data/*.example.json
docs/*
!docs/.gitkeep
!docs/versionado.md

# Credenciales / secretos locales
.env
*.key
credenciales*
secrets*

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Overrides de Docker Compose específicos de cada máquina (rutas absolutas,
# nombres de contenedor) -- nunca deben subirse ni pisarse con git reset.
docker-compose.override.yml

# Agentes de Claude Code (.claude/agents/) -- son herramienta de flujo
# de trabajo del desarrollador, no parte del producto. Un repo de
# equipo real no versiona la configuración del asistente de IA de cada
# dev; quedan solo en local (ver .claude/agents/security-devops.md
# para el criterio completo). .claude/settings.json SÍ se versiona --
# es un hook de equipo, no config personal.
.claude/agents/

# Salidas de las corridas del agente qa-responsive (capturas .png y el
# .xlsx de bugs encontrados) -- son artefactos de una corrida puntual,
# no código fuente. El helper reutilizable sí se versiona
# (tools/qa/playwright_utils.py).
qa_reports/

# Scripts de diagnóstico/debug temporales (prefijo "_") generados por agentes
# de QA durante una corrida puntual. El helper reutilizable (_utils.py) sí se
# versiona; estos descartes de un día no.
tools/qa/_*.py

# Scripts de conveniencia local (no son parte del producto)
abrir_base_de_datos.bat

# Excepciones (deben ir al final para ganarle a las reglas de arriba):
# archivos *.example.json son plantillas sin datos reales, sí se versionan.
!data/*.example.json
